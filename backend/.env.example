# Database Configuration
# Use local SQLite by default: sqlite:///./poetrystudio.db
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/poetrystudio
DATABASE_URL=sqlite:///./poetrystudio.db

# LLM Providers API Keys (Optional if USE_MOCK_LLM=true)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Google Keep Credentials (Optional if USE_MOCK_KEEP=true)
GOOGLE_KEEP_EMAIL=
GOOGLE_KEEP_PASSWORD=

# Mocks Configuration (Set to true to run without API keys / Keep credentials)
USE_MOCK_LLM=true
USE_MOCK_KEEP=true

# Server Configuration
PORT=8000
HOST=127.0.0.1
